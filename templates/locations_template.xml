<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stockable — Storage Locations Import Template
  ===============================================
  Import this file via Settings → DB Control → Import XML.

  IMPORTANT: Importing will DELETE all existing storage_locations rows and
  replace them with the rows defined here. Omitting a table element leaves
  that table untouched.

  Column reference for <storage_locations>
  -----------------------------------------
  id                  INTEGER  Auto-assigned on import (include unique values to preserve references)
  location_code       TEXT     Unique human-readable code, e.g. "CAB-001"
  batch_id            TEXT     UUID or identifier grouping locations created together
  batch_index         INTEGER  0-based position within the batch
  batch_size          INTEGER  Total number of locations in the batch
  use_metric          INTEGER  1 = metric (cm/kg), 0 = imperial (in/lbs)
  storage_type        TEXT     Cabinet | Floor | Rack
  storage_environment TEXT     Indoor | Outdoor
  storage_layout      TEXT     Bulk
  compartment_type    TEXT     None | Drawer | Shelf | Both
  drawers             INTEGER  Number of drawer units (0 if no drawers)
  shelves             INTEGER  Number of shelf units (0 if no shelves)
  drawer_rows         INTEGER  Rows per drawer unit (0 if no drawers)
  drawer_columns      INTEGER  Columns per drawer unit (0 if no drawers)
  shelf_rows          INTEGER  Rows per shelf unit (0 if no shelves)
  shelf_columns       INTEGER  Columns per shelf unit (0 if no shelves)
  min_length          INTEGER  Minimum item length accepted (in selected unit)
  max_length          INTEGER  Maximum item length accepted
  min_width           INTEGER  Minimum item width accepted
  max_width           INTEGER  Maximum item width accepted
  min_height          INTEGER  Minimum item height accepted
  max_height          INTEGER  Maximum item height accepted
  min_weight          INTEGER  Minimum item weight accepted
  max_weight          INTEGER  Maximum item weight accepted
  drawer_length       INTEGER  Internal drawer length (0 if not applicable)
  drawer_width        INTEGER  Internal drawer width (0 if not applicable)
  drawer_height       INTEGER  Internal drawer height (0 if not applicable)
  drawer_max_weight   INTEGER  Maximum weight per drawer (0 if not applicable)
  shelf_length        INTEGER  Internal shelf length (0 if not applicable)
  shelf_width         INTEGER  Internal shelf width (0 if not applicable)
  shelf_height        INTEGER  Internal shelf height (0 if not applicable)
  shelf_max_weight    INTEGER  Maximum weight per shelf (0 if not applicable)
  created_at          TEXT     ISO-8601 timestamp, e.g. "2026-05-04T10:00:00.000"
  updated_at          TEXT     ISO-8601 timestamp, e.g. "2026-05-04T10:00:00.000"
-->
